# Create a key at https://aistudio.google.com/apikey. Never commit .env.
GEMINI_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it
MODEL_PROVIDER=google
# Optional offline inference after: ollama pull gemma4:e2b
# Set MODEL_PROVIDER=ollama to use this model; no API key or cloud fallback.
OLLAMA_MODEL=gemma4:e2b
PORT=3000
# Local demo binds to loopback. Use 0.0.0.0 only behind production access controls.
HOST=127.0.0.1
